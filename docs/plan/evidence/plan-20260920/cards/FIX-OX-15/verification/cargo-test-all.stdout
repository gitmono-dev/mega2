[2m2026-10-10T13:36:08.221584Z[0m [32m INFO[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"SELECT current_schema() AS schema,n.oid::bigint …" [3mdb.statement[0m[2m=[0m"\n\nSELECT current_schema() AS schema,n.oid::bigint AS oid FROM pg_catalog.pg_namespace n WHERE n.nspname=current_schema()\n" [3mrows_affected[0m[2m=[0m1 [3mrows_returned[0m[2m=[0m1 [3melapsed[0m[2m=[0m1.348583ms [3melapsed_secs[0m[2m=[0m0.001348583
