# Opt-in: enable artifact_objects GC with short periods (plan-20261001 BB-46).
# GC deletes artifact objects that no committed set references once their
# last_seen_at is older than the grace period; use it on the lab stack only.
#
# scripts/bb_optin_run.sh gc ... recreates mega2 with this file and restores
# the default stack afterwards. By hand:
#
#   docker compose -p mega2-trunk -f docker/docker-compose-storage-only.yml \
#     --env-file config/compose.env.storage-only.artifacts-gc \
#     up -d --wait --no-deps --force-recreate mega2
#
# Revert: drop --env-file and --force-recreate mega2 again.

MEGA_ARTIFACTS_GC__ENABLE=true
MEGA_ARTIFACTS_GC__INTERVAL_SECS=5
MEGA_ARTIFACTS_GC__GRACE_SECS=1
MEGA_ARTIFACTS_GC__BATCH_LIMIT=100
