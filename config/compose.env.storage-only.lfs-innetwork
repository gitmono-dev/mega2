# Opt-in: LFS hrefs reachable from the compose network (plan-20260906 ADR-SO-04).
#
# Default compose publishes MEGA_HTTP__PUBLIC_BASE_URL=http://127.0.0.1:9000 for
# host clients. git-smoke runs inside the network and must see mega2:8000.
#
#   docker compose -p mega2-trunk -f docker/docker-compose-storage-only.yml \
#     --env-file config/compose.env.storage-only.lfs-innetwork \
#     up -d --wait --force-recreate mega2
#
# Revert: drop --env-file and --force-recreate mega2 again.

MEGA_HTTP__PUBLIC_BASE_URL=http://mega2:8000
MEGA_LFS__SSH__HTTP_URL=http://mega2:8000
# Presigned LFS object URLs: sign for the in-network RustFS. The compose
# default signs for the host port 127.0.0.1:29000, which git-smoke cannot reach.
MEGA_OBJECT_STORAGE__S3__PUBLIC_ENDPOINT_URL=http://rustfs:9000
