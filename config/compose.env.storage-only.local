# Optional override: switch mega2 from default RustFS to local filesystem.
#
# Default RustFS stack — do NOT pass this file:
#   docker compose -p mega2-trunk -f docker/docker-compose-storage-only.yml up -d --wait
#
# Local filesystem backend only (this file):
#   docker compose -p mega2-trunk -f docker/docker-compose-storage-only.yml \
#     --env-file config/compose.env.storage-only.local up -d --wait
#
# Note: RustFS still starts with the default stack; this file only switches
# mega2's storage_type to local.

MEGA_OBJECT_STORAGE__STORAGE_TYPE=local
MEGA_OBJECT_STORAGE__LOCAL__ROOT_DIR=/var/lib/mega2/objects
