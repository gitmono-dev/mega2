export MEGA_DATABASE__DB_TYPE=postgres
export MEGA_DATABASE__DB_URL=postgres://monoengine:monoengine_test_password@127.0.0.1:15432/monoengine
export MEGA_REDIS__URL=redis://127.0.0.1:16379

# Optional website-next SMTP-capture endpoints for website authentication and
# product-email IT. Monoengine neither reads these values nor sends SMTP.
export MAILPIT_API_URL=http://127.0.0.1:18025
export MAILPIT_SMTP_HOST=127.0.0.1
export MAILPIT_SMTP_PORT=11025

# Website product-email API client values for isolated IT only. They are not
# SMTP settings and must match the `website-next` Compose service when used.
export MEGA_NOTIFICATION__WEBSITE_MAIL_BASE_URL=http://127.0.0.1:17001
export MEGA_NOTIFICATION__WEBSITE_MAIL_BEARER=monoengine-it-website-mail-bearer-0001

# RustFS test service for the S3-compatible object storage backend gate.
# Uncomment when running docker-compose.test.yml with the rustfs service.
# Credentials must match `RUSTFS_ACCESS_KEY` / `RUSTFS_SECRET_KEY` in
# docker-compose.test.yml (`rustfs` / `rustfs_secret`).
# export MEGA_OBJECT_STORAGE__STORAGE_TYPE=s3compatible
# export MEGA_OBJECT_STORAGE__S3__REGION=us-east-1
# export MEGA_OBJECT_STORAGE__S3__BUCKET=testbucket
# export MEGA_OBJECT_STORAGE__S3__ENDPOINT_URL=http://127.0.0.1:19000
# export MEGA_OBJECT_STORAGE__S3__ACCESS_KEY_ID=rustfs
# export MEGA_OBJECT_STORAGE__S3__SECRET_ACCESS_KEY=rustfs_secret

# Compose-hosted monoengine (profile `app`) HTTP probe target.
# export MONOENGINE_IT_HTTP_URL=http://127.0.0.1:19180

# CI-only gate: config-validation.yml exports WEBSITE_IT=1 to run the stack
# level website auth/mail targets against `--profile app --profile web`.
# Intentionally not exported by default locally (those targets SKIP without
# the web stack); opt in explicitly when the full stack is up.
# export WEBSITE_IT=1
